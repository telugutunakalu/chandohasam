digraph T {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.25, ranksep=0.4, bgcolor="white", pad=0.3];
  node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9.5, fillcolor="#f4f6fa", color="#6b7a90", penwidth=1.1, margin="0.14,0.06"];
  edge  [color="#6b7a90", arrowsize=0.7, fontname="Helvetica", fontsize=8.5];
  ed   [label="editorial glossary splits\n2,296,552 entries → 727,269 word types\n(47% with a split)", fillcolor="#e8f1ff"];
  data [label="data/ (prepare_data.py)\ntrain 582,335 · dev 72,823 · test 72,111 types\nsplit by type hash 80/10/10"];
  dd   [label="data_dict / data_split\nthe same types, targets relabelled by\ndictionary rules and the particle convention"];
  dc   [label="data_context\n1,142,980 instances with left/right context"];
  bil  [label="BiLSTM splitter (dict_split)\nchar labels = rewrites · emb 128 · 2×256\ndev word accuracy 0.612, split F1 0.742", fillcolor="#e9f7ec", color="#4e8a5a"];
  ctx  [label="context BiLSTM\ndev word accuracy 0.825, split F1 0.822", fillcolor="#e9f7ec", color="#4e8a5a"];
  pipe [label="pipeline output (strong classes, high confidence)\n+ 59,082 paradigm forms + glossary & Annamayya pairs", fillcolor="#e8f1ff"];
  dist [label="data_distill (332,128 → 337,864 pairs)\nword → parts with →headword"];
  byt5 [label="ByT5-small distilled (distill_v2)\nAdafactor 5e-4 · bf16 · 21,116 steps\ndev exact 0.788 · headword 0.842", fillcolor="#e9f7ec", color="#4e8a5a"];
  gold [label="annotation gold\n14,129 verdicts · 6,348 words (78 human)\ncompile_gold → held-out 1,837 words", fillcolor="#fff4e5"];
  ft   [label="fine-tune on gold overrides (×3)\n+ 20k base sample: +2–3 points", fillcolor="#e9f7ec", color="#4e8a5a"];
  pairs[label="resolver pairs\n2,000 stripper-derived + 562 gold (300 held out)\n→ 12-feature logistic weights", fillcolor="#e9f7ec", color="#4e8a5a"];
  rules[label="guaranteed table 1,803\n1,621 agreed + 39 human verdicts + 143 closed-class", fillcolor="#e9f7ec", color="#4e8a5a"];
  d46  [label="dictionary 46: 309 judge headwords", fillcolor="#e9f7ec", color="#4e8a5a"];
  ed -> data -> dd -> bil; data -> dc -> ctx; pipe -> dist -> byt5; gold -> ft -> bil [style=dashed]; gold -> pairs; gold -> rules; gold -> d46;
  gold -> byt5 [label="held out as test_gold", style=dashed];
}
