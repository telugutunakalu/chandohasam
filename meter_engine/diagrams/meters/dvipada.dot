digraph "dvipada" {
  rankdir=LR; fontname="Helvetica,Arial,sans-serif"; labelloc=b; fontsize=11;
  label="ద్విపద  ·  dvipada  ·  jati\n2 lines per unit, slot pattern: all all  (repeatable)\naksharas per line: 11–15  ·  prāsa: yes  ·  prāsa-yati: no";
  node [shape=box, style="rounded,filled", fontname="Helvetica,Arial,sans-serif", fontsize=10, fillcolor="#f4f4f4"];
  edge [color="#607d8b", arrowsize=0.7];
  subgraph "cluster_all" {
    label="slot all  (lines 1, 2)"; style="rounded,dashed"; color="#90a4ae"; fontsize=10;
    "all_start" [shape=circle, label="", width=0.18, fillcolor="#37474f"];
    "all_end" [shape=doublecircle, label="", width=0.18, fillcolor="#37474f"];
    "all_G1" [label="G1\nభ UII  ·  ర UIU\nత UUI  ·  నల IIII\nనగ IIIU  ·  సల IIUI", fillcolor="#f4f4f4"];
    "all_start" -> "all_G1";
    "all_G2" [label="G2\nభ UII  ·  ర UIU\nత UUI  ·  నల IIII\nనగ IIIU  ·  సల IIUI", fillcolor="#f4f4f4"];
    "all_G1" -> "all_G2";
    "all_G3" [label="G3\nభ UII  ·  ర UIU\nత UUI  ·  నల IIII\nనగ IIIU  ·  సల IIUI\n◆ యతి (gana start)", fillcolor="#ffe082"];
    "all_G2" -> "all_G3";
    "all_G4" [label="G4\nన III  ·  హ UI", fillcolor="#f4f4f4"];
    "all_G3" -> "all_G4";
    "all_G4" -> "all_end";
  }
}