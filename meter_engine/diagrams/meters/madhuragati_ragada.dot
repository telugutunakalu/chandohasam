    "all_G3" [label="G3\nగా UU  ·  స IIU\nజ IUI  ·  భ UII\nనల IIII\n◆ యతి (gana start)", fillcolor="#ffe082"];
    "all_G2" -> "all_G3";
    "all_G4" [label="G4\nగా UU  ·  స IIU\nజ IUI  ·  భ UII\nనల IIII", fillcolor="#f4f4f4"];
