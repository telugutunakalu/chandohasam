digraph "mahasragdhara" {
  rankdir=LR; fontname="Helvetica,Arial,sans-serif"; labelloc=b; fontsize=11;
  label="మహాస్రగ్ధర  ·  mahasragdhara  ·  vrutta\n4 lines per unit, slot pattern: all all all all\naksharas per line: 22  ·  prāsa: yes  ·  prāsa-yati: no";
  node [shape=box, style="rounded,filled", fontname="Helvetica,Arial,sans-serif", fontsize=10, fillcolor="#f4f4f4"];
  edge [color="#607d8b", arrowsize=0.7];
  subgraph "cluster_all" {
    label="slot all  (lines 1, 2, 3, 4)"; style="rounded,dashed"; color="#90a4ae"; fontsize=10;
    "all_start" [shape=circle, label="", width=0.18, fillcolor="#37474f"];
    "all_end" [shape=doublecircle, label="", width=0.18, fillcolor="#37474f"];
    "all_G1" [label="G1\nస IIU", fillcolor="#e3f2fd"];
    "all_start" -> "all_G1";
    "all_G2" [label="G2\nత UUI", fillcolor="#e3f2fd"];
    "all_G1" -> "all_G2";
    "all_G3" [label="G3\nత UUI\n◆ యతి @ akshara 9", fillcolor="#ffe082"];
    "all_G2" -> "all_G3";
    "all_G4" [label="G4\nన III", fillcolor="#e3f2fd"];
    "all_G3" -> "all_G4";
    "all_G5" [label="G5\nస IIU", fillcolor="#e3f2fd"];
    "all_G4" -> "all_G5";
    "all_G6" [label="G6\nర UIU\n◆ యతి @ akshara 16", fillcolor="#ffe082"];
    "all_G5" -> "all_G6";
    "all_G7" [label="G7\nర UIU", fillcolor="#e3f2fd"];
    "all_G6" -> "all_G7";
    "all_G8" [label="G8\nగురువు U", fillcolor="#e3f2fd"];
    "all_G7" -> "all_G8";
    "all_G8" -> "all_end";
  }
}