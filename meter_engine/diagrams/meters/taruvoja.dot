digraph "taruvoja" {
  rankdir=LR; fontname="Helvetica,Arial,sans-serif"; labelloc=b; fontsize=11;
  label="తరువోజ  ·  taruvoja  ·  jati\n4 lines per unit, slot pattern: all all all all\naksharas per line: 22–30  ·  prāsa: yes  ·  prāsa-yati: no";
