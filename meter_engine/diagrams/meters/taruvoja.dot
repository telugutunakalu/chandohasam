    "all_G2" -> "all_G3";
    "all_G4" [label="G4\nన III  ·  హ UI", fillcolor="#f4f4f4"];
    "all_G3" -> "all_G4";
    "all_G5" [label="G5\nభ UII  ·  ర UIU\nత UUI  ·  నల IIII\nనగ IIIU  ·  సల IIUI\n◆ యతి (gana start)", fillcolor="#ffe082"];
    "all_G4" -> "all_G5";
