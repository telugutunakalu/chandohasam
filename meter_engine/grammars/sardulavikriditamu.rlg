L3.G3_IUI_2 → I L3.G4         # జ ja: symbol 3/3, complete → L3.G4
L3.G4 → I L3.G4_IIU_1         # స sa: symbol 1/3 read, 2 to go
L3.G4_IIU_1 → I L3.G4_IIU_2   # స sa: symbol 2/3 read, 1 to go
L3.G4_IIU_2 → U L3.G5         # స sa: symbol 3/3, complete → L3.G5
L3.G5 → U L3.G5_UUI_1         # త ta: symbol 1/3 read, 2 to go
L3.G5_UUI_1 → U L3.G5_UUI_2   # త ta: symbol 2/3 read, 1 to go
L3.G5_UUI_2 → I L3.G6         # త ta: symbol 3/3, complete → L3.G6
L3.G6 → U L3.G6_UUI_1         # త ta: symbol 1/3 read, 2 to go
L3.G6_UUI_1 → U L3.G6_UUI_2   # త ta: symbol 2/3 read, 1 to go
L3.G6_UUI_2 → I L3.G7         # త ta: symbol 3/3, complete → L3.G7
L3.G7 → U L3.G7_UNL_1         # గురువు guruvu: symbol 1/2 read, 1 to go
L3.G7_UNL_1 → ⏎ L4.G1         # గురువు guruvu: symbol 2/2, complete → L4.G1
L4.G1 → U L4.G1_UUU_1         # మ ma: symbol 1/3 read, 2 to go
L4.G1_UUU_1 → U L4.G1_UUU_2   # మ ma: symbol 2/3 read, 1 to go
L4.G1_UUU_2 → U L4.G2         # మ ma: symbol 3/3, complete → L4.G2
L4.G2 → I L4.G2_IIU_1         # స sa: symbol 1/3 read, 2 to go
