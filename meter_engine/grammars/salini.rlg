# శాలిని · salini — prosodic grammar (vrutta, 4 lines, 11 aksharas per line)
# generated from meter_rules.yaml by indic_meter_dawg; do not edit by hand
#
# One grammar, three forms: (1) hierarchical, for reading; (2) right-linear, the same language flattened;
# (3) strict, one symbol per production = the prosodic automaton. All three generate exactly the same poems.
#
# Terminals: U = guru (2 matras), I = laghu (1 matra), ⏎ = line separator.
# Nonterminals: Poem, Unit, Line_<slot>, gana classes (Surya, Indra, Kanda, M4 …), ganas (భ, ర, …).
#   Kanda−జ  = the class minus జ (a constraint removed it)   Kanda=జ|నల = only జ or నల allowed
#   Kanda$U  = only members ending in a guru                   X⟨U⟩ = inside the branch where every line starts with U
#   L2.G3    = line 2, about to read gana 3 (forms 2 and 3)
#   A_UUI_2  = inside alternative UUI of A, 2 symbols already read (form 3 only)

# ===== 1. Hierarchical: Poem → lines → gana classes → ganas → symbols
# poem
Poem → Line ⏎ Line ⏎ Line ⏎ Line                 # 4 lines

# lines
Line → మ త త గా                                  # slot all: 4 ganas

# ganas → symbols
మ → U U U                                        # ma, 6 matras
త → U U I                                        # ta, 5 matras
గా → U U                                         # gaa, 4 matras

# ===== 2. Right-linear (A → wB | w) over {U, I, ⏎}: the hierarchy flattened
Poem → UUU L1.G2
L1.G2 → UUI L1.G3
L1.G3 → UUI L1.G4
L1.G4 → UU⏎ L2.G1
L2.G1 → UUU L2.G2
L2.G2 → UUI L2.G3
L2.G3 → UUI L2.G4
L2.G4 → UU⏎ L3.G1
L3.G1 → UUU L3.G2
L3.G2 → UUI L3.G3
L3.G3 → UUI L3.G4
L3.G4 → UU⏎ L4.G1
L4.G1 → UUU L4.G2
L4.G2 → UUI L4.G3
L4.G3 → UUI L4.G4
L4.G4 → UU

# ===== 3. Strict (A → aB | a): 47 productions, 48 states;
# minimized prosodic automaton: 48 states. Every production is commented.
Poem → U Poem_UUU_1             # మ ma: symbol 1/3 read, 2 to go
Poem_UUU_1 → U Poem_UUU_2       # మ ma: symbol 2/3 read, 1 to go
Poem_UUU_2 → U L1.G2            # మ ma: symbol 3/3, complete → L1.G2
L1.G2 → U L1.G2_UUI_1           # త ta: symbol 1/3 read, 2 to go
L1.G2_UUI_1 → U L1.G2_UUI_2     # త ta: symbol 2/3 read, 1 to go
L1.G2_UUI_2 → I L1.G3           # త ta: symbol 3/3, complete → L1.G3
L1.G3 → U L1.G3_UUI_1           # త ta: symbol 1/3 read, 2 to go
L1.G3_UUI_1 → U L1.G3_UUI_2     # త ta: symbol 2/3 read, 1 to go
L1.G3_UUI_2 → I L1.G4           # త ta: symbol 3/3, complete → L1.G4
L1.G4 → U L1.G4_UUNL_1          # గా gaa: symbol 1/3 read, 2 to go
L1.G4_UUNL_1 → U L1.G4_UUNL_2   # గా gaa: symbol 2/3 read, 1 to go
L1.G4_UUNL_2 → ⏎ L2.G1          # గా gaa: symbol 3/3, complete → L2.G1
L2.G1 → U L2.G1_UUU_1           # మ ma: symbol 1/3 read, 2 to go
L2.G1_UUU_1 → U L2.G1_UUU_2     # మ ma: symbol 2/3 read, 1 to go
L2.G1_UUU_2 → U L2.G2           # మ ma: symbol 3/3, complete → L2.G2
L2.G2 → U L2.G2_UUI_1           # త ta: symbol 1/3 read, 2 to go
L2.G2_UUI_1 → U L2.G2_UUI_2     # త ta: symbol 2/3 read, 1 to go
L2.G2_UUI_2 → I L2.G3           # త ta: symbol 3/3, complete → L2.G3
L2.G3 → U L2.G3_UUI_1           # త ta: symbol 1/3 read, 2 to go
L2.G3_UUI_1 → U L2.G3_UUI_2     # త ta: symbol 2/3 read, 1 to go
L2.G3_UUI_2 → I L2.G4           # త ta: symbol 3/3, complete → L2.G4
L2.G4 → U L2.G4_UUNL_1          # గా gaa: symbol 1/3 read, 2 to go
L2.G4_UUNL_1 → U L2.G4_UUNL_2   # గా gaa: symbol 2/3 read, 1 to go
L2.G4_UUNL_2 → ⏎ L3.G1          # గా gaa: symbol 3/3, complete → L3.G1
L3.G1 → U L3.G1_UUU_1           # మ ma: symbol 1/3 read, 2 to go
L3.G1_UUU_1 → U L3.G1_UUU_2     # మ ma: symbol 2/3 read, 1 to go
L3.G1_UUU_2 → U L3.G2           # మ ma: symbol 3/3, complete → L3.G2
L3.G2 → U L3.G2_UUI_1           # త ta: symbol 1/3 read, 2 to go
L3.G2_UUI_1 → U L3.G2_UUI_2     # త ta: symbol 2/3 read, 1 to go
L3.G2_UUI_2 → I L3.G3           # త ta: symbol 3/3, complete → L3.G3
L3.G3 → U L3.G3_UUI_1           # త ta: symbol 1/3 read, 2 to go
L3.G3_UUI_1 → U L3.G3_UUI_2     # త ta: symbol 2/3 read, 1 to go
L3.G3_UUI_2 → I L3.G4           # త ta: symbol 3/3, complete → L3.G4
L3.G4 → U L3.G4_UUNL_1          # గా gaa: symbol 1/3 read, 2 to go
L3.G4_UUNL_1 → U L3.G4_UUNL_2   # గా gaa: symbol 2/3 read, 1 to go
L3.G4_UUNL_2 → ⏎ L4.G1          # గా gaa: symbol 3/3, complete → L4.G1
L4.G1 → U L4.G1_UUU_1           # మ ma: symbol 1/3 read, 2 to go
L4.G1_UUU_1 → U L4.G1_UUU_2     # మ ma: symbol 2/3 read, 1 to go
L4.G1_UUU_2 → U L4.G2           # మ ma: symbol 3/3, complete → L4.G2
L4.G2 → U L4.G2_UUI_1           # త ta: symbol 1/3 read, 2 to go
L4.G2_UUI_1 → U L4.G2_UUI_2     # త ta: symbol 2/3 read, 1 to go
L4.G2_UUI_2 → I L4.G3           # త ta: symbol 3/3, complete → L4.G3
L4.G3 → U L4.G3_UUI_1           # త ta: symbol 1/3 read, 2 to go
L4.G3_UUI_1 → U L4.G3_UUI_2     # త ta: symbol 2/3 read, 1 to go
L4.G3_UUI_2 → I L4.G4           # త ta: symbol 3/3, complete → L4.G4
L4.G4 → U L4.G4_UU_1            # గా gaa: symbol 1/2 read, 1 to go
L4.G4_UU_1 → U                  # గా gaa: symbol 2/2, complete, line ends
